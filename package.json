{
  "name": "web-control",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:debug": "DEBUG_BUILD=true nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxt generate && serve .output/public -l 3042",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:nuxt": "vitest --project nuxt",
    "test:unit": "vitest --project unit",
    "test:run:nuxt": "vitest run --project nuxt --coverage --coverage.reportsDirectory=coverage/nuxt",
    "test:run:unit": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit",
    "type-check": "nuxt typecheck",
    "lint": "eslint --fix",
    "lint:no-fix": "eslint",
    "format": "prettier -w .",
    "format:no-fix": "prettier -c ."
  },
  "dependencies": {
    "@iconify-json/svg-spinners": "^1.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.13.1",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/i18n": "^10.7.0",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "nuxt": "^4.7.0",
    "nuxt-svgo": "^5.3.5",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.5",
    "valibot": "^1.5.0",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.2",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^20.14.6",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.23.0"
}
