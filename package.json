{
  "name": "web-control",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxt generate && serve .output/public -l 3042",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "type-check": "vue-tsc",
    "lint": "eslint --fix",
    "lint:no-fix": "eslint",
    "format": "prettier -w .",
    "format:no-fix": "prettier -c ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.1.0",
    "@nuxtjs/i18n": "^10.1.2",
    "@tailwindcss/vite": "^4.1.16",
    "eslint": "^9.38.0",
    "nuxt": "^4.2.0",
    "nuxt-svgo": "^4.2.6",
    "tailwindcss": "^4.1.16",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.20.1",
    "@playwright/test": "^1.56.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.10",
    "playwright-core": "^1.56.1",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5",
    "vue-tsc": "^3.1.2"
  }
