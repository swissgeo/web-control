{
  "name": "web-control",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:debug": "DEBUG_BUILD=true nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxt generate && serve .output/public -l 3042",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:nuxt": "vitest --project nuxt",
    "test:unit": "vitest --project unit",
    "test:run:nuxt": "vitest run --project nuxt --coverage --coverage.reportsDirectory=coverage/nuxt",
    "test:run:unit": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit",
    "type-check": "nuxt typecheck",
    "lint": "eslint --fix",
    "lint:no-fix": "eslint",
    "format": "prettier -w .",
    "format:no-fix": "prettier -c ."
  },
  "dependencies": {
    "@iconify-json/svg-spinners": "^1.2.4",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.1.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/i18n": "^10.1.2",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.1.16",
    "date-fns": "^4.1.0",
    "eslint": "^9.38.0",
    "nuxt": "^4.2.0",
    "nuxt-svgo": "^4.2.6",
    "oidc-client-ts": "^3.4.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.16",
    "valibot": "^1.2.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.1.1",
    "@nuxt/test-utils": "^3.20.1",
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.10",
    "playwright-core": "^1.56.1",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.1.2"
  }
}
