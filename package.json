{
  "name": "web-control",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:debug": "DEBUG_BUILD=true nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxt generate && serve .output/public -l 3042",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:nuxt": "vitest --project nuxt",
    "test:unit": "vitest --project unit",
    "test:run:nuxt": "vitest run --project nuxt",
    "test:run:unit": "vitest run --project unit",
    "type-check": "nuxt typecheck",
    "lint": "eslint --fix",
    "lint:no-fix": "eslint",
    "format": "prettier -w .",
    "format:no-fix": "prettier -c ."
  },
  "dependencies": {
    "@iconify-json/svg-spinners": "^1.2.4",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.6.1",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/i18n": "^10.2.4",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.2.2",
    "date-fns": "^4.1.0",
    "eslint": "^10.2.0",
    "nuxt": "^4.4.2",
    "nuxt-svgo": "^4.0.2",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^3.0.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "valibot": "^1.3.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.3.0",
    "@nuxt/test-utils": "^4.0.0",
    "@playwright/test": "^1.59.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.9",
    "playwright-core": "^1.59.1",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}
